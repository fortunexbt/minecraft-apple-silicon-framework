# Separate visual showcase, NEVER a timed reference-flight capture.
# \showcase prepare : verify/hold view for native F2, leave recovery state.
# \showcase restore : restore pose/settings/window and FIRST_PERSON.
import sys
import atexit
from pathlib import Path
from minescript import JavaClass, player, world_info, execute, echo, add_event_listener, remove_event_listener

mc = JavaClass('net.minecraft.client.Minecraft').getInstance()
System = JavaClass('java.lang.System')
Properties = JavaClass('java.util.Properties')
Input = JavaClass('java.io.FileInputStream')
Output = JavaClass('java.io.FileOutputStream')
File = JavaClass('java.io.File')
Camera = JavaClass('net.minecraft.client.CameraType')
Sink = JavaClass('m4peak.FrameSink')
window = mc.getWindow()
mode = str(sys.argv[1]) if len(sys.argv) > 1 else 'prepare'
state_path = 'minescript/showcase-overworld-front-v1.properties'
p = Properties()
listener = -1
finished = False
ready_since = 0
ready_frames = 0
resize_attempts = 0
last_resize = 0
born = System.nanoTime()


def absolute(value):
    return -value if value < 0 else value


def release_inputs():
    for key in [mc.options.keyUp, mc.options.keyDown, mc.options.keyLeft, mc.options.keyRight, mc.options.keyJump, mc.options.keyShift, mc.options.keySprint]:
        key.setDown(False)


def resize_to_target():
    ratio_x = window.getWidth() / window.getScreenWidth()
    ratio_y = window.getHeight() / window.getScreenHeight()
    if ratio_x <= 0 or ratio_y <= 0:
        raise Exception('Invalid framebuffer/logical backing ratio')
    logical_width = int(1920 / ratio_x + 0.5)
    logical_height = int(1080 / ratio_y + 0.5)
    window.setWindowed(logical_width, logical_height)


def save(path):
    out = Output(path)
    try:
        p.store(out, 'Local showcase recovery/observation; not benchmark acceptance')
    finally:
        out.close()


def prop(name, value):
    p.setProperty(name, str(value))


def boolean(name):
    return str(p.getProperty(name)).lower() == 'true'


def guard():
    if Sink.recording:
        raise Exception('Refusing showcase while FrameSink is recording')
    server = mc.getSingleplayerServer()
    world = world_info()
    if server == None or str(world.name) != 'Silicon Shader Overworld v1' or str(world.dimension) != 'minecraft:overworld':
        raise Exception('Showcase requires the dedicated reference world')
    if server.getWorldGenSettings().options().seed() - 20260929 > 0.000001 or 20260929 - server.getWorldGenSettings().options().seed() > 0.000001:
        raise Exception('Showcase world seed mismatch')


def restore(reason):
    guard()
    release_inputs()
    # The benchmark always resumes first-person; prior camera remains recorded.
    mc.options.setCameraType(Camera.FIRST_PERSON)
    mc.options.fov().set(JavaClass('java.lang.Integer').valueOf(p.getProperty('prior_fov')))
    if mc.gui.hud.isHidden() != boolean('prior_hud_hidden'):
        mc.gui.hud.toggle()
    execute('tp @s ' + p.getProperty('prior_x') + ' ' + p.getProperty('prior_y') + ' ' + p.getProperty('prior_z') + ' ' + p.getProperty('prior_yaw') + ' ' + p.getProperty('prior_pitch'))
    window.setFullscreen(False)
    window.setWindowed(JavaClass('java.lang.Integer').valueOf(p.getProperty('prior_logical_width')), JavaClass('java.lang.Integer').valueOf(p.getProperty('prior_logical_height')))
    window.setExclusiveFullscreen(boolean('prior_exclusive_fullscreen'))
    mc.options.exclusiveFullscreen().set(boolean('prior_exclusive_option'))
    mc.options.fullscreen().set(boolean('prior_fullscreen'))
    window.setFullscreen(boolean('prior_fullscreen'))
    prop('restore_requested', True)
    prop('restore_reason', reason)
    prop('restore_camera', str(mc.options.getCameraType()))
    save('minescript/showcase-' + p.getProperty('run_id') + '-receipt.properties')
    File(state_path).delete()


def exit_cleanup():
    # A successful prepare intentionally leaves the view and recovery file intact.
    if not finished and File(state_path).exists():
        try:
            restore('interrupted_prepare')
        except Exception:
            pass


if mode == 'restore':
    if not File(state_path).exists():
        raise Exception('No showcase recovery state exists')
    stream = Input(state_path)
    try:
        p.load(stream)
    finally:
        stream.close()
    restore('operator_restore')
    finished = True
    echo('Showcase restoration requested; first-person camera restored')
elif mode == 'prepare':
    guard()
    if File(state_path).exists():
        raise Exception('Run \\showcase restore before preparing another view')
    pose = player()
    prop('run_id', str(JavaClass('java.util.UUID').randomUUID()))
    prop('screenshot_view', 'overworld-front-v1')
    prop('acceptance', 'visual_showcase_only; inspect actual screenshot and dimensions')
    prop('provenance', 'name_and_seed_guard; operator_creation_receipt_required')
    prop('prior_camera', str(mc.options.getCameraType()))
    prop('prior_fov', mc.options.fov().get())
    prop('prior_hud_hidden', mc.gui.hud.isHidden())
    prop('prior_fullscreen', mc.options.fullscreen().get())
    prop('prior_exclusive_fullscreen', window.isExclusiveFullscreen())
    prop('prior_exclusive_option', mc.options.exclusiveFullscreen().get())
    prop('prior_logical_width', window.getScreenWidth())
    prop('prior_logical_height', window.getScreenHeight())
    prop('prior_framebuffer_width', window.getWidth())
    prop('prior_framebuffer_height', window.getHeight())
    prop('prior_x', pose.position[0])
    prop('prior_y', pose.position[1])
    prop('prior_z', pose.position[2])
    prop('prior_yaw', pose.yaw)
    prop('prior_pitch', pose.pitch)
    save(state_path)
    atexit.register(exit_cleanup)
    try:
        mc.options.fullscreen().set(False)
        window.setFullscreen(False)
        resize_to_target()
        mc.options.setCameraType(Camera.THIRD_PERSON_FRONT)
        mc.options.fov().set(70)
        if not mc.gui.hud.isHidden():
            mc.gui.hud.toggle()
        release_inputs()
        execute('gamerule minecraft:advance_time false')
        execute('gamerule minecraft:advance_weather false')
        execute('time set 6000')
        execute('weather clear 1200s')
        execute('tp @s -109.5 70.0 438.5 0 0')
    except Exception as error:
        restore('prepare_error')
        finished = True
        raise Exception(str(error))

    def on_render(event):
        global ready_since, ready_frames, finished, resize_attempts, last_resize
        try:
            guard()
            release_inputs()
            now = System.nanoTime()
            if now - born > 15000000000:
                raise Exception('Showcase resize/exposure timeout')
            if not mc.isWindowActive() or mc.isPaused() or mc.gui.screen() != None or mc.gui.overlay() != None:
                ready_since = 0
                ready_frames = 0
                return
            if absolute(window.getWidth() - 1920) > 0.1 or absolute(window.getHeight() - 1080) > 0.1:
                ready_since = 0
                ready_frames = 0
                if now - last_resize >= 1000000000 and resize_attempts < 3:
                    resize_to_target()
                    resize_attempts += 1
                    last_resize = now
                return
            if ready_since <= 0:
                ready_since = now
            ready_frames += 1
            if now - ready_since < 5000000000 or ready_frames < 60:
                return
            pose = player()
            world = world_info()
            if absolute(pose.position[0] + 109.5) > 0.01 or absolute(pose.position[1] - 70) > 0.01 or absolute(pose.position[2] - 438.5) > 0.01:
                raise Exception('Showcase actual pose differs from selected composition')
            if absolute((pose.yaw + 180) % 360 - 180) > 0.01 or absolute(pose.pitch) > 0.01:
                raise Exception('Showcase actual camera angles differ from yaw0 pitch0')
            if str(mc.options.getCameraType()) != 'THIRD_PERSON_FRONT' or absolute(mc.options.fov().get() - 70) > 0.000001 or not mc.gui.hud.isHidden():
                raise Exception('Showcase requires front camera, FOV70 and hidden HUD')
            if world.raining or world.thundering or absolute(world.day_ticks % 24000 - 6000) > 0.000001:
                raise Exception('Showcase requires actual clear noon')
            prop('actual_day_ticks', world.day_ticks)
            prop('actual_raining', world.raining)
            prop('actual_thundering', world.thundering)
            prop('actual_camera', str(mc.options.getCameraType()))
            prop('actual_fov', mc.options.fov().get())
            prop('actual_hud_hidden', mc.gui.hud.isHidden())
            prop('actual_width', window.getWidth())
            prop('actual_height', window.getHeight())
            prop('actual_x', pose.position[0])
            prop('actual_y', pose.position[1])
            prop('actual_z', pose.position[2])
            prop('actual_yaw', pose.yaw)
            prop('actual_pitch', pose.pitch)
            prop('capture_ready_nano', now)
            prop('capture_status', 'ready_for_native_F2')
            save(state_path)
            save('minescript/showcase-' + p.getProperty('run_id') + '-receipt.properties')
            echo('Showcase ready at 1920x1080; use native F2, inspect screenshot, then \\showcase restore')
            finished = True
            # Last operation: retain view/recovery state, end the readiness listener.
            remove_event_listener(listener)
        except Exception as error:
            try:
                restore('capture_error: ' + str(error))
                echo('Showcase failed and restoration requested: ' + str(error))
            except Exception as restore_error:
                echo('Showcase failed: ' + str(error) + '; restoration failed: ' + str(restore_error) + '; recovery state retained at ' + state_path)
            finally:
                finished = True
                # Last operation: teardown may destroy the Java handle table.
                remove_event_listener(listener)

    listener = add_event_listener('render', on_render)
else:
    raise Exception('Usage: \\showcase prepare | \\showcase restore')
